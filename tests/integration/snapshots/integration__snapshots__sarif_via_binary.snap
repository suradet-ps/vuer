---
source: tests/integration/snapshots.rs
expression: out.stdout
---
{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "vuer",
          "information_uri": "https://github.com/suradet-ps/vuer",
          "version": "0.2.0",
          "rules": [
            {
              "id": "vue/security/no-v-html",
              "name": "vue/security/no-v-html",
              "short_description": {
                "text": "Disallow `v-html` directive"
              },
              "full_description": {
                "text": "Rendering untrusted HTML can execute arbitrary JavaScript."
              },
              "help": {
                "text": "Sanitise with DOMPurify or use `v-text` / interpolation."
              },
              "default_configuration": {
                "level": "error"
              },
              "properties": {
                "category": "security",
                "security_severity": "critical"
              }
            },
            {
              "id": "vue/security/no-dynamic-bind-src",
              "name": "vue/security/no-dynamic-bind-src",
              "short_description": {
                "text": "Disallow dynamic `src` binding"
              },
              "full_description": {
                "text": "A dynamic `src` can load attacker-controlled resources."
              },
              "help": {
                "text": "Validate and sanitise the URL against an allow-list."
              },
              "default_configuration": {
                "level": "error"
              },
              "properties": {
                "category": "security",
                "security_severity": "high"
              }
            },
            {
              "id": "vue/best-practice/no-inline-style",
              "name": "vue/best-practice/no-inline-style",
              "short_description": {
                "text": "Disallow inline `style`"
              },
              "full_description": {
                "text": "Inline styles bypass the cascade and are hard to maintain."
              },
              "help": {
                "text": "Use a CSS class instead."
              },
              "default_configuration": {
                "level": "note"
              },
              "properties": {
                "category": "best-practice",
                "security_severity": "low"
              }
            },
            {
              "id": "vue/accessibility/no-img-without-alt",
              "name": "vue/accessibility/no-img-without-alt",
              "short_description": {
                "text": "Require `alt` on `<img>`"
              },
              "full_description": {
                "text": "An image without `alt` is announced as its filename (or skipped) by screen readers."
              },
              "help": {
                "text": "Add `alt` text, or `alt=\"\"` for decorative images."
              },
              "default_configuration": {
                "level": "warning"
              },
              "properties": {
                "category": "accessibility",
                "security_severity": "medium"
              }
            },
            {
              "id": "vue/security/no-inner-html",
              "name": "vue/security/no-inner-html",
              "short_description": {
                "text": "Disallow `el.innerHTML = ...`"
              },
              "full_description": {
                "text": "Writing to `.innerHTML` lets attackers inject script tags."
              },
              "help": {
                "text": "Use `textContent` for plain text or sanitise with DOMPurify."
              },
              "default_configuration": {
                "level": "error"
              },
              "properties": {
                "category": "security",
                "security_severity": "critical"
              }
            },
            {
              "id": "vue/security/no-document-write",
              "name": "vue/security/no-document-write",
              "short_description": {
                "text": "Disallow `document.write`"
              },
              "full_description": {
                "text": "`document.write` is a known XSS sink."
              },
              "help": {
                "text": "Use `appendChild` or update via Vue reactivity instead."
              },
              "default_configuration": {
                "level": "error"
              },
              "properties": {
                "category": "security",
                "security_severity": "high"
              }
            },
            {
              "id": "vue/security/no-eval",
              "name": "vue/security/no-eval",
              "short_description": {
                "text": "Disallow `eval` / `new Function`"
              },
              "full_description": {
                "text": "Evaluating strings as code is RCE if any input is attacker-controlled."
              },
              "help": {
                "text": "Refactor to a static expression or a lookup table."
              },
              "default_configuration": {
                "level": "error"
              },
              "properties": {
                "category": "security",
                "security_severity": "critical"
              }
            },
            {
              "id": "vue/security/no-dangerous-url",
              "name": "vue/security/no-dangerous-url",
              "short_description": {
                "text": "Disallow dangerous URL schemes"
              },
              "full_description": {
                "text": "`javascript:`, `data:text/html`, and `vbscript:` URLs execute code."
              },
              "help": {
                "text": "Use `https?://` URLs or a router."
              },
              "default_configuration": {
                "level": "error"
              },
              "properties": {
                "category": "security",
                "security_severity": "critical"
              }
            },
            {
              "id": "vue/security/no-open-redirect",
              "name": "vue/security/no-open-redirect",
              "short_description": {
                "text": "Disallow open redirect sinks"
              },
              "full_description": {
                "text": "Forwarding user-controlled data to `location.*` enables open-redirect attacks."
              },
              "help": {
                "text": "Validate the URL against an allow-list of hostnames."
              },
              "default_configuration": {
                "level": "error"
              },
              "properties": {
                "category": "security",
                "security_severity": "high"
              }
            },
            {
              "id": "vue/security/no-unsafe-localstorage",
              "name": "vue/security/no-unsafe-localstorage",
              "short_description": {
                "text": "Disallow auth tokens in `localStorage`"
              },
              "full_description": {
                "text": "Tokens in `localStorage` are reachable by any injected script."
              },
              "help": {
                "text": "Prefer an `HttpOnly; Secure` cookie set by the server."
              },
              "default_configuration": {
                "level": "error"
              },
              "properties": {
                "category": "security",
                "security_severity": "high"
              }
            },
            {
              "id": "vue/security/no-unsafe-iframe",
              "name": "vue/security/no-unsafe-iframe",
              "short_description": {
                "text": "Disallow `<iframe>` without `sandbox`"
              },
              "full_description": {
                "text": "An `iframe` without `sandbox` inherits the embedding origin's capabilities."
              },
              "help": {
                "text": "Add `sandbox=\"\"` (or an explicit allow-list)."
              },
              "default_configuration": {
                "level": "warning"
              },
              "properties": {
                "category": "security",
                "security_severity": "medium"
              }
            },
            {
              "id": "vue/security/no-postmessage-wildcard",
              "name": "vue/security/no-postmessage-wildcard",
              "short_description": {
                "text": "Disallow `postMessage(..., '*')`"
              },
              "full_description": {
                "text": "A wildcard `targetOrigin` lets a malicious site that has navigated the target window intercept the message."
              },
              "help": {
                "text": "Pin the receiver's exact origin (e.g. `https://app.example.com`) or use `/` for same-origin delivery."
              },
              "default_configuration": {
                "level": "error"
              },
              "properties": {
                "category": "security",
                "security_severity": "high"
              }
            },
            {
              "id": "vue/security/no-window-open-blank-noopener",
              "name": "vue/security/no-window-open-blank-noopener",
              "short_description": {
                "text": "Require `noopener` on `window.open(..., '_blank', ...)`"
              },
              "full_description": {
                "text": "Without `noopener`, the opened tab can call `window.opener.location = ...` and phish the originating page (reverse tabnabbing)."
              },
              "help": {
                "text": "Add `noopener` (or `noreferrer`) to the `windowFeatures` string."
              },
              "default_configuration": {
                "level": "error"
              },
              "properties": {
                "category": "security",
                "security_severity": "high"
              }
            },
            {
              "id": "vue/security/no-fetch-without-timeout",
              "name": "vue/security/no-fetch-without-timeout",
              "short_description": {
                "text": "Require an `AbortSignal` on `fetch`"
              },
              "full_description": {
                "text": "A `fetch` without a signal can hang indefinitely and exhaust connection pools."
              },
              "help": {
                "text": "Pass `signal: ctrl.signal` from an `AbortController` and call `ctrl.abort()` on timeout / unmount."
              },
              "default_configuration": {
                "level": "error"
              },
              "properties": {
                "category": "security",
                "security_severity": "high"
              }
            },
            {
              "id": "vue/best-practice/no-watch-with-callback",
              "name": "vue/best-practice/no-watch-with-callback",
              "short_description": {
                "text": "Disallow module-scope `watch` with a callback"
              },
              "full_description": {
                "text": "A `watch(source, callback)` call at module scope has no component lifecycle to dispose it, so it keeps its closure alive until the page unloads."
              },
              "help": {
                "text": "Move it into a component, or stop it explicitly with the returned stop handle."
              },
              "default_configuration": {
                "level": "note"
              },
              "properties": {
                "category": "best-practice",
                "security_severity": "low"
              }
            },
            {
              "id": "vue/best-practice/v-for-missing-key",
              "name": "vue/best-practice/v-for-missing-key",
              "short_description": {
                "text": "Require `:key` on `v-for`"
              },
              "full_description": {
                "text": "Without a stable `:key`, Vue falls back to index-based reconciliation."
              },
              "help": {
                "text": "Add `:key=\"item.id\"`."
              },
              "default_configuration": {
                "level": "warning"
              },
              "properties": {
                "category": "best-practice",
                "security_severity": "medium"
              }
            },
            {
              "id": "vue/performance/no-v-if-with-v-for",
              "name": "vue/performance/no-v-if-with-v-for",
              "short_description": {
                "text": "Disallow `v-if` with `v-for` on the same element"
              },
              "full_description": {
                "text": "Vue 3 evaluates `v-if` before `v-for`, so the list is built and then discarded when the condition is false."
              },
              "help": {
                "text": "Filter the list with a computed property instead."
              },
              "default_configuration": {
                "level": "warning"
              },
              "properties": {
                "category": "performance",
                "security_severity": "medium"
              }
            },
            {
              "id": "vue/performance/no-deep-watch-without-handler",
              "name": "vue/performance/no-deep-watch-without-handler",
              "short_description": {
                "text": "Disallow deep watchers on inline options"
              },
              "full_description": {
                "text": "A `watch(source, cb, { deep: true })` watcher re-compares every nested property on each mutation."
              },
              "help": {
                "text": "Watch an explicit path or use `{ once: true }`."
              },
              "default_configuration": {
                "level": "note"
              },
              "properties": {
                "category": "performance",
                "security_severity": "low"
              }
            },
            {
              "id": "vue/performance/no-reactive-in-v-for",
              "name": "vue/performance/no-reactive-in-v-for",
              "short_description": {
                "text": "Disallow reactive creation in loop bodies"
              },
              "full_description": {
                "text": "Creating `ref`/`reactive`/`computed` wrappers inside a loop allocates a fresh effect per iteration."
              },
              "help": {
                "text": "Hoist the wrapper out of the loop."
              },
              "default_configuration": {
                "level": "note"
              },
              "properties": {
                "category": "performance",
                "security_severity": "low"
              }
            },
            {
              "id": "vue/performance/no-large-list-without-virtualization",
              "name": "vue/performance/no-large-list-without-virtualization",
              "short_description": {
                "text": "Heuristic: large lists need virtual scrolling"
              },
              "full_description": {
                "text": "A `v-for` over a large-looking collection without a virtual-scroll wrapper can freeze the main thread."
              },
              "help": {
                "text": "Wrap the list in a virtual-scroll component or paginate."
              },
              "default_configuration": {
                "level": "note"
              },
              "properties": {
                "category": "performance",
                "security_severity": "low"
              }
            },
            {
              "id": "vue/accessibility/no-click-without-role-keyboard",
              "name": "vue/accessibility/no-click-without-role-keyboard",
              "short_description": {
                "text": "Require `role` + keyboard on `@click` of non-interactive elements"
              },
              "full_description": {
                "text": "An element that reacts to clicks but cannot receive keyboard focus is unreachable for keyboard-only users."
              },
              "help": {
                "text": "Use a real interactive element, or add `role` and a keyboard handler."
              },
              "default_configuration": {
                "level": "warning"
              },
              "properties": {
                "category": "accessibility",
                "security_severity": "medium"
              }
            },
            {
              "id": "vue/accessibility/no-form-without-label",
              "name": "vue/accessibility/no-form-without-label",
              "short_description": {
                "text": "Require a label on form fields"
              },
              "full_description": {
                "text": "An unlabelled input is announced only as its type by screen readers."
              },
              "help": {
                "text": "Associate a `<label>` or add `aria-label`."
              },
              "default_configuration": {
                "level": "warning"
              },
              "properties": {
                "category": "accessibility",
                "security_severity": "medium"
              }
            },
            {
              "id": "vue/accessibility/no-button-without-type",
              "name": "vue/accessibility/no-button-without-type",
              "short_description": {
                "text": "Require `type` on `<button>`"
              },
              "full_description": {
                "text": "A `<button>` without `type` defaults to `submit`, so a click inside a form submits and navigates."
              },
              "help": {
                "text": "Set `type=\"button\"` for in-page actions."
              },
              "default_configuration": {
                "level": "note"
              },
              "properties": {
                "category": "accessibility",
                "security_severity": "low"
              }
            },
            {
              "id": "vue/architecture/no-side-effect-in-computed",
              "name": "vue/architecture/no-side-effect-in-computed",
              "short_description": {
                "text": "Disallow side effects in `computed`"
              },
              "full_description": {
                "text": "A computed getter must be pure; Vue re-evaluates it lazily and unpredictably."
              },
              "help": {
                "text": "Move side effects to a `watch` or event handler."
              },
              "default_configuration": {
                "level": "warning"
              },
              "properties": {
                "category": "architecture",
                "security_severity": "medium"
              }
            },
            {
              "id": "vue/architecture/no-mutation-of-props",
              "name": "vue/architecture/no-mutation-of-props",
              "short_description": {
                "text": "Disallow `defineProps` writes"
              },
              "full_description": {
                "text": "Writing to a prop diverges the child from the parent and is lost on the next re-render."
              },
              "help": {
                "text": "`emit` an event and let the parent update its state."
              },
              "default_configuration": {
                "level": "warning"
              },
              "properties": {
                "category": "architecture",
                "security_severity": "medium"
              }
            },
            {
              "id": "vue/architecture/no-async-setup-without-error-boundary",
              "name": "vue/architecture/no-async-setup-without-error-boundary",
              "short_description": {
                "text": "Heuristic: `async setup()` needs `<Suspense>`"
              },
              "full_description": {
                "text": "An `async setup()` component renders nothing until its promise resolves without a `Suspense` boundary."
              },
              "help": {
                "text": "Wrap the component in `<Suspense>` or suppress with a rationale."
              },
              "default_configuration": {
                "level": "note"
              },
              "properties": {
                "category": "architecture",
                "security_severity": "low"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "vue/security/no-v-html",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Unsafe `v-html` directive renders untrusted HTML"
          },
